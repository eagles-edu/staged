<div class="sp-header-card">
  <div class="sp-avatar{{#haspicture}} has-img{{/haspicture}}" style="background:{{avatarcolor}};">
    {{#haspicture}}<img src="{{pictureurl}}" alt="{{name}}" loading="lazy">{{/haspicture}}
    {{^haspicture}}{{initials}}{{/haspicture}}
  </div>
  <div class="sp-header-info">
    <h2 class="sp-header-name">{{name}}</h2>
    <div class="sp-header-email">{{email}}</div>
    <div class="sp-header-tags">
      <span class="mwa-presence {{presencetone}}"><i aria-hidden="true"></i>{{presencelabel}}</span>
      <span class="sp-tag">&#128197; {{firstdate}} - {{lastdate}}</span>
      <button type="button" class="sp-tag sp-achievements-button" data-sname="{{name}}" onclick="window.MWAProfile&&window.MWAProfile.openAchievements(this.getAttribute('data-sname'))">
        <span aria-hidden="true">&#127941;</span> {{achievementtotal}} {{achievementslabel}}
      </button>
    </div>
  </div>
</div>
<div class="sp-kpi-row">
  <div class="sp-kpi">
    <div class="sp-kpi-head"><span class="sp-kpi-icon sp-kpi-icon-access" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-clock"></use></svg></span><div class="sp-kpi-label">{{lastaccesslabel}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_last_access, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_last_access, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_last_access, block_mwa_dashboard{{/str}}">?</span></div></div>
    <div class="sp-kpi-val" style="color:{{agocolor}};">{{ago}}{{agosuffix}}</div>
    <div class="sp-kpi-sub">{{lastdate}}</div>
  </div>
  <div class="sp-kpi">
    <div class="sp-kpi-head"><span class="sp-kpi-icon sp-kpi-icon-active" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-flame"></use></svg></span><div class="sp-kpi-label">{{activedayslabel}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_active_days, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_active_days, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_active_days, block_mwa_dashboard{{/str}}">?</span></div></div>
    <div class="sp-kpi-val" style="color:var(--teal);">{{uniquedays}}</div>
    <div class="sp-kpi-sub">{{total}} {{interactionslabel}}</div>
  </div>
  <button type="button" class="sp-kpi sp-kpi-interventions" data-sname="{{name}}"{{^hasinterventions}} disabled aria-disabled="true"{{/hasinterventions}} onclick="window.MWAProfile&&window.MWAProfile.openInterventionHistory(this.getAttribute('data-sname'))">
    <div class="sp-kpi-head"><span class="sp-kpi-icon sp-kpi-icon-interventions" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-message"></use></svg></span><div class="sp-kpi-label">{{interventionslabel}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}student_interventions_tip, block_mwa_dashboard{{/str}}" title="{{#str}}student_interventions_tip, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}student_interventions_tip, block_mwa_dashboard{{/str}}">?</span></div></div>
    <div class="sp-kpi-val">{{interventionstotal}}</div>
    <div class="sp-kpi-sub">{{interventionssub}}</div>
  </button>
  <div class="sp-kpi">
    <div class="sp-kpi-head"><span class="sp-kpi-icon sp-kpi-icon-grade" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-star"></use></svg></span><div class="sp-kpi-label">{{gradelabel}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_grade, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_grade, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_grade, block_mwa_dashboard{{/str}}">?</span></div></div>
    <div class="sp-kpi-val" style="color:{{gradecolor}};">{{gradevalue}}</div>
    <div class="sp-kpi-sub">{{gradesub}}</div>
  </div>
  <div class="sp-kpi">
    <div class="sp-kpi-head">
      <div class="sp-kpi-label">{{#str}}sp_kpi_engagement, block_mwa_dashboard{{/str}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_engagement, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_engagement, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_engagement, block_mwa_dashboard{{/str}}">?</span></div>
    </div>
    <div class="sp-engagement-tags">
      {{{followupreasonhtml}}}
      <span class="sp-engagement-chip {{engagementtone}}">{{englabel}}</span>
    </div>
    <div class="sp-kpi-sub">{{#str}}sp_score_format, block_mwa_dashboard, {{score}}{{/str}}</div>
  </div>
</div>
<div class="sp-progress-row">
  <div class="sp-progress-card">
    <h3>{{activityprogresslabel}}<span class="mwa-help-tip mwa-grade-rules-tip" tabindex="0" role="img" aria-label="{{#str}}grade_state_rules_tip, block_mwa_dashboard{{/str}}" title="{{#str}}grade_state_rules_tip, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}grade_state_rules_tip, block_mwa_dashboard{{/str}}">?</span></h3>
    {{{activityprogresshtml}}}
    <div class="sp-progress-legend">
      <span><i class="sp-legend-dot done"></i>{{#str}}sp_activity_legend_done, block_mwa_dashboard{{/str}}</span>
      <span><i class="sp-legend-dot awaiting-grade"></i>{{#str}}sp_activity_legend_awaiting, block_mwa_dashboard{{/str}}</span>
      <span><i class="sp-legend-dot pending"></i>{{#str}}sp_activity_legend_missing, block_mwa_dashboard{{/str}}</span>
      <span><i class="sp-legend-dot overdue"></i>{{#str}}sp_activity_legend_overdue, block_mwa_dashboard{{/str}}</span>
      <span><i class="sp-legend-dot unavailable"></i>{{#str}}sp_activity_legend_unavailable, block_mwa_dashboard{{/str}}</span>
    </div>
  </div>
  <div class="sp-progress-card">
    <h3>{{resourceprogresslabel}}</h3>
    {{{resourceprogresshtml}}}
    <div class="sp-progress-legend">
      <span><i class="sp-legend-dot done"></i>{{#str}}sp_resource_legend_done, block_mwa_dashboard{{/str}}</span>
      <span><i class="sp-legend-dot pending"></i>{{#str}}sp_resource_legend_missing, block_mwa_dashboard{{/str}}</span>
      <span><i class="sp-legend-dot unavailable"></i>{{#str}}sp_resource_legend_unavailable, block_mwa_dashboard{{/str}}</span>
    </div>
  </div>
</div>
<div class="sp-section">
  <div class="sp-section-head">
    &#128202; {{activity7d}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_activity_7d, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_activity_7d, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_activity_7d, block_mwa_dashboard{{/str}}">?</span>
    <div class="sp-section-right">{{{trendhtml}}}</div>
  </div>
  <div class="sp-section-body">
    {{^hasweekdata}}
      <div class="sp-card-empty">{{nodatalabel}}</div>
    {{/hasweekdata}}
    {{#hasweekdata}}
    <div class="sp-sparkline-wrap">
      <svg width="70" height="36" viewBox="0 0 70 36" style="display:block;">{{{sparksvg}}}</svg>
      <span style="font-size:.78rem;color:var(--muted);padding-bottom:2px;">{{weekinteractions}} {{weeklabel}}</span>
    </div>
    {{/hasweekdata}}
  </div>
</div>
<div class="sp-section">
  <div class="sp-section-head">&#128197; {{#str}}sp_timeline_label, block_mwa_dashboard{{/str}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_timeline, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_timeline, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_timeline, block_mwa_dashboard{{/str}}">?</span></div>
  <div class="sp-section-body"><div id="spTimeline_{{calendarid}}"><div class="sp-card-empty">{{nodatalabel}}</div></div></div>
</div>
<div class="sp-section">
  <div class="sp-section-head">&#128200; {{dailyjourney}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_daily_journey, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_daily_journey, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_daily_journey, block_mwa_dashboard{{/str}}">?</span></div>
  <div class="sp-section-body">
    {{^hasdailydata}}<div class="sp-card-empty">{{nodatalabel}}</div>{{/hasdailydata}}
    {{#hasdailydata}}<div style="height:180px;"><canvas id="spDailyChart"></canvas></div>{{/hasdailydata}}
  </div>
</div>
<div class="sp-section" style="margin-top:18px;">
  <div class="sp-section-head">&#128197; {{activitycalendar}}<span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}sp_tip_activity_calendar, block_mwa_dashboard{{/str}}" title="{{#str}}sp_tip_activity_calendar, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}sp_tip_activity_calendar, block_mwa_dashboard{{/str}}">?</span></div>
  <div class="sp-section-body"><div id="{{calendarid}}"><div class="sp-card-empty">{{nodatalabel}}</div></div></div>
</div>
