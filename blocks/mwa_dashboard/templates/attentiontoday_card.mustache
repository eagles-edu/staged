<section class="card mwa-att-card">
    <header>
        <div>
            <span class="mwa-att-title-icon"><svg class="mwa-ui-icon"><use href="#mwa-icon-bell"></use></svg></span>
            <h2>{{title}}</h2><b>{{pendingcount}} {{pendinglabel}}</b>
        </div>
        <button type="button" class="mwa-att-config"><svg class="mwa-ui-icon"><use href="#mwa-icon-edit"></use></svg>{{configurelabel}}</button>
    </header>
    <nav>
        {{#filters}}<button type="button" data-att-filter="{{value}}" class="{{#active}}active{{/active}}">{{label}}</button>{{/filters}}
    </nav>
    <div class="mwa-att-list">
        {{{rowshtml}}}
        {{#empty}}<div class="mwa-att-empty">{{emptylabel}}</div>{{/empty}}
    </div>
    {{#hasalerts}}
    <footer class="mwa-att-card-footer">
        <button type="button" class="mwa-att-view-all">{{viewalllabel}}</button>
        <button type="button" class="mwa-att-view-students">{{viewstudentslabel}}</button>
    </footer>
    {{/hasalerts}}
</section>
